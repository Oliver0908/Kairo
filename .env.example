# ==========================================
# Kairo - Environment Variables Template
# ==========================================

# 1. Supabase Database & Realtime
# (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. AI & Transcription Providers
# (Gemini API key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key

# (Groq API keys for ultra-fast Whisper speech-to-text)
# Comma-separated list for auto-rotation across rate limits
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=gsk_key1

# (Deepgram API key as automatic fallback transcription provider)
DEEPGRAM_API_KEY=your_deepgram_api_key

# 3. Frontend Environment Variables (Next.js)
# Place these in Vercel project settings or frontend/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_BACKEND_URL=https://your-huggingface-space.hf.space
NEXT_PUBLIC_API_URL=https://your-huggingface-space.hf.space
